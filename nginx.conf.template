server {
    listen ${PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # Keep the default MIME table (a `types {}` block here would replace it)
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Static Assets caching (3D models, Images, JS, CSS, Fonts)
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        expires 6M;
        add_header Cache-Control "public, max-age=15552000, immutable";
        try_files $uri =404;
    }

    # glTF/GLB models need explicit MIME types (set per-location, not via `types`)
    location ~* \.glb$ {
        default_type model/gltf-binary;
        expires 6M;
        add_header Cache-Control "public, max-age=15552000, immutable";
        try_files $uri =404;
    }

    location ~* \.gltf$ {
        default_type model/gltf+json;
        expires 6M;
        add_header Cache-Control "public, max-age=15552000, immutable";
        try_files $uri =404;
    }

    # Angular SPA client-side routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Health check endpoint for Railway monitoring
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
